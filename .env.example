# ============================================================================
# Marblo Environment Configuration
# ============================================================================
# Copy this to .env and fill in your values
# For Docker Compose: Used in docker-compose.yml
# For Deployment: Copy to EC2 as .env.production

# ============================================================================
# Application
# ============================================================================
ENVIRONMENT=development
# Options: development, staging, production
# Controls logging level, debugging features, and defaults

DEBUG=true
# true for development (enables hot-reload, verbose logging)
# false for production (disables hot-reload, optimizes performance)

APP_NAME=Marblo
APP_VERSION=0.1.0

# ============================================================================
# Database - PostgreSQL
# ============================================================================
# Local development (Docker Compose):
DATABASE_URL=postgresql://marblo_user:marblo_password@postgres:5432/marblo_db

# AWS Production (RDS):
# DATABASE_URL=postgresql://marblo_admin:YOUR_PASSWORD@marblo-postgres.xxxxxx.us-east-1.rds.amazonaws.com:5432/marblo_db

# Alternative format:
# POSTGRES_USER=marblo_user
# POSTGRES_PASSWORD=marblo_password
# POSTGRES_DB=marblo_db
# POSTGRES_PORT=5432

# Connection pool settings (for production)
DATABASE_POOL_SIZE=10       # Number of connections to keep in pool
DATABASE_MAX_OVERFLOW=20    # Additional connections when pool exhausted

# ============================================================================
# Redis Cache
# ============================================================================
# Local development (Docker Compose):
REDIS_URL=redis://redis:6379/0

# AWS Production (ElastiCache):
# REDIS_URL=redis://marblo-redis.xxxxxx.ng.0001.use1.cache.amazonaws.com:6379/0

REDIS_CACHE_TTL=3600  # Cache time-to-live in seconds (1 hour)

# ============================================================================
# AWS Configuration
# ============================================================================
AWS_REGION=us-east-1
# Supported regions: us-east-1, us-west-2, eu-west-1, ap-southeast-1

# AWS Credentials (leave empty to use instance IAM role in production)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# S3 Configuration
AWS_S3_BUCKET=marblo-photos
# Bucket name must be globally unique
# Example: marblo-photos-20240115-abc123

AWS_S3_REGION=us-east-1
# Region for S3 bucket (should match AWS_REGION)

# CloudWatch Configuration
AWS_CLOUDWATCH_LOG_GROUP=/marblo/application
# Log group created by Terraform: /aws/marblo/{environment}/application

# ============================================================================
# AI/ML Services
# ============================================================================
# Claude (Bedrock or API)
CLAUDE_API_KEY=your_claude_api_key
# For AWS Bedrock: Leave empty, use IAM role instead
# For Direct API: Get from https://console.anthropic.com/

CLAUDE_MODEL=claude-3-sonnet-20240229
# Options: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key
# Used if configured instead of Claude

# ============================================================================
# Email Service
# ============================================================================
EMAIL_PROVIDER=ses
# Options: ses (AWS SES), sendgrid

# If using SendGrid:
SENDGRID_API_KEY=your_sendgrid_api_key
# Get from: https://sendgrid.com/

# Email configuration
EMAIL_FROM=noreply@marblo.com
EMAIL_FROM_NAME=Marblo
FRONTEND_URL=http://localhost:3000  # For email links

# ============================================================================
# Security & Secrets
# ============================================================================
SECRET_KEY=dev-secret-key-change-in-production
# Used for JWT token generation
# Generate with: openssl rand -hex 32
# Must be different in each environment
# IMPORTANT: Change in production!

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================================
# Password Requirements
# ============================================================================
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated list of allowed origins
# Production: https://marblo.com,https://www.marblo.com

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100    # Requests allowed per period
RATE_LIMIT_PERIOD=60       # Period in seconds

# ============================================================================
# File Upload
# ============================================================================
MAX_FILE_SIZE_MB=50        # Maximum photo size (50 MB)
MAX_FILE_SIZE_STYLE_MB=100 # Maximum style learning file size (100 MB)

# Allowed image MIME types
# Supported: image/jpeg, image/png, image/webp, image/gif
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ============================================================================
# Generation (AI API Calls)
# ============================================================================
GENERATION_TIMEOUT_SECONDS=60  # Post generation timeout
PHOTO_ANALYSIS_TIMEOUT_SECONDS=30  # Photo metadata extraction timeout

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=DEBUG
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG for development, INFO for production

LOG_FORMAT=json
# Options: json, text
# json is better for CloudWatch parsing

# ============================================================================
# Pagination
# ============================================================================
DEFAULT_PAGE_SIZE=20      # Default items per page
MAX_PAGE_SIZE=100         # Maximum allowed items per page

# ============================================================================
# Development Tools (Local Only)
# ============================================================================
# These are used only in docker-compose for development
RELOAD_FLAG=--reload      # Enable hot-reload (production: remove this)
BUILD_TARGET=development  # Docker build stage (production: set to 'production')

# ============================================================================
# Docker Compose (Services)
# ============================================================================
# PostgreSQL
POSTGRES_USER=marblo_user
POSTGRES_PASSWORD=marblo_password
POSTGRES_DB=marblo_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Application
APP_PORT=8000
HTTP_PORT=80
HTTPS_PORT=443

# ============================================================================
# Production Deployment Tips
# ============================================================================
# 1. Generate a new SECRET_KEY: openssl rand -hex 32
# 2. Use strong DATABASE password (12+ chars, mixed case, numbers, symbols)
# 3. Use AWS IAM roles instead of storing access keys
# 4. Enable CloudWatch logging
# 5. Set appropriate CORS_ORIGINS for your domain
# 6. Use strong email service credentials
# 7. Configure CloudWatch alarms for monitoring
# 8. Set up automated backups for RDS
# 9. Enable S3 versioning and lifecycle policies
# 10. Use HTTPS with CloudFront distribution

