# Example Terraform Variables for Marblo Deployment
# Copy to terraform.tfvars and update with your values

aws_region = "us-east-1"
environment = "development"
app_name = "marblo"

# Database configuration
database_name = "marblo_db"
database_user = "marblo_admin"
database_password = "YourSecurePassword123!@#"  # Must be 12+ chars with uppercase, lowercase, numbers, special chars

# S3 configuration - must be globally unique
s3_bucket_name = "marblo-photos-your-unique-id"

# EC2 configuration
instance_type = "t3.medium"
desired_capacity = 1
min_capacity = 1
max_capacity = 2

# Optional: SNS topic for alerts
sns_alert_topic_arn = ""

# Enhanced monitoring (use false for cost savings)
enable_enhanced_monitoring = false
